{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GESTUR runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "active_model", "tracking", "render", "controls"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "active_model": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9][A-Za-z0-9_. -]*(/[A-Za-z0-9][A-Za-z0-9_. -]*)*\\.(obj|gltf|glb)$"},
    "tracking": {
      "type": "object", "additionalProperties": false,
      "required": ["use_pose", "use_hands", "inference_fps", "hand_fps", "camera_index", "width", "height", "mirror", "smoothing_ms"],
      "properties": {
        "use_pose": {"type": "boolean"},
        "use_hands": {"type": "boolean"},
        "inference_fps": {"type": "number", "minimum": 5, "maximum": 60},
        "hand_fps": {"type": "number", "minimum": 5, "maximum": 30},
        "camera_index": {"type": "integer", "minimum": 0, "maximum": 16},
        "width": {"type": "integer", "minimum": 160, "maximum": 1920},
        "height": {"type": "integer", "minimum": 120, "maximum": 1080},
        "mirror": {"type": "boolean"},
        "smoothing_ms": {"type": "number", "minimum": 0, "maximum": 1000}
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "required": ["target_fps", "antialias_samples", "fullscreen", "hide_cursor"],
      "properties": {
        "target_fps": {"type": "integer", "minimum": 15, "maximum": 120},
        "antialias_samples": {"type": "integer", "enum": [0, 2, 4]},
        "fullscreen": {"type": "boolean"},
        "hide_cursor": {"type": "boolean"}
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["smoothing_ms", "reset_timeout_seconds", "reset_duration_seconds", "mappings"],
      "properties": {
        "smoothing_ms": {"type": "number", "minimum": 0, "maximum": 1000},
        "reset_timeout_seconds": {"type": "number", "minimum": 0, "maximum": 30},
        "reset_duration_seconds": {"type": "number", "minimum": 0.1, "maximum": 10},
        "mappings": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "input", "output", "mode", "enabled", "scale", "invert", "center"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
              "input": {"type": "string", "enum": ["head_x", "head_y", "head_scale", "hands_center_x", "hands_center_y", "hands_distance", "hands_separation_x", "left_hand_rotation", "right_hand_rotation", "left_hand_pitch", "right_hand_pitch", "left_hand_yaw", "right_hand_yaw", "left_hand_pinch", "right_hand_pinch"]},
              "output": {"type": "string", "enum": ["rotation_yaw", "rotation_pitch", "rotation_roll", "position_x", "position_y", "position_z", "scale_uniform"]},
              "mode": {"type": "string", "enum": ["absolute", "hybrid", "stepped"]},
              "enabled": {"type": "boolean"},
              "scale": {"type": "number", "minimum": 0, "maximum": 360},
              "invert": {"type": "boolean"},
              "center": {"type": "number", "minimum": 0, "maximum": 1},
              "left_threshold": {"type": "number", "minimum": 0.01, "maximum": 0.99},
              "right_threshold": {"type": "number", "minimum": 0.01, "maximum": 0.99},
              "continuous_speed": {"type": "number", "minimum": 0, "maximum": 360},
              "threshold": {"type": "number", "minimum": 0, "maximum": 1},
              "small_scale": {"type": "number", "minimum": 0.1, "maximum": 5},
              "large_scale": {"type": "number", "minimum": 0.1, "maximum": 5},
              "transition_ms": {"type": "number", "minimum": 0, "maximum": 5000},
              "hysteresis": {"type": "number", "minimum": 0, "maximum": 0.2}
            },
            "allOf": [
              {
                "if": {"properties": {"mode": {"const": "hybrid"}}},
                "then": {
                  "required": ["left_threshold", "right_threshold", "continuous_speed"],
                  "properties": {"output": {"enum": ["rotation_yaw", "rotation_pitch", "rotation_roll"]}}
                }
              },
              {
                "if": {"properties": {"mode": {"const": "stepped"}}},
                "then": {
                  "required": ["threshold", "small_scale", "large_scale", "transition_ms", "hysteresis"],
                  "properties": {"output": {"const": "scale_uniform"}}
                }
              }
            ]
          }
        }
      }
    }
  }
}
