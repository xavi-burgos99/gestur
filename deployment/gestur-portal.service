[Unit]
Description=GESTUR local administration portal
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=gestur-portal
Group=gestur
SupplementaryGroups=gestur-portal
WorkingDirectory=/opt/gestur/portal
Environment=NODE_ENV=production
Environment=PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=GESTUR_CONFIG=/var/lib/gestur/config.json
Environment=GESTUR_MODELS_DIR=/var/lib/gestur/models
Environment=GESTUR_TOKEN_FILE=/etc/gestur/portal-token
ExecStartPre=/usr/bin/node /opt/gestur/scripts/check-importer.mjs
ExecStart=/usr/bin/node /opt/gestur/portal/server/index.mjs
Restart=on-failure
RestartSec=3
UMask=0007
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/gestur
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Bind HTTP as gestur-portal. Keep sudo's setuid/setgid path available for the
# exact Wi-Fi helper; NoNewPrivileges or a bind-only bounding set would block it.

[Install]
WantedBy=multi-user.target
